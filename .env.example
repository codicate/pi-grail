# Documentation only: the extension does NOT automatically load .env files.
# Prefer `npm run jev:auth` to store the key outside the repository.
TYPESAFE_API_KEY=
PI_GRAIL_JEV_MODEL=jev-latest
# Optional API root, without /v1; defaults to https://api.typesafe.ai.
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# Optional key-file override; otherwise ~/.pi/agent/secrets/typesafe_api_key.
# PI_GRAIL_API_KEY_FILE=/absolute/path/to/key
