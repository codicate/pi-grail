{
  "name": "pi-grail",
  "version": "0.1.0",
  "private": true,
  "description": "Local Pi extension bootstrap with a minimal TypeSafe Jev client",
  "type": "module",
  "license": "UNLICENSED",
  "repository": {"type": "git", "url": "https://github.com/codicate/pi-grail.git"},
  "keywords": ["pi-package", "pi-extension", "jev"],
  "pi": {
    "extensions": ["./extensions/index.ts"]
  },
  "scripts": {
    "dev": "node scripts/pi.mjs --approve",
    "link": "node scripts/pi.mjs install .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "test:pi": "tsx scripts/test-pi.ts",
    "test:pi:live": "tsx scripts/test-pi-live.ts",
    "pi:status": "node scripts/pi.mjs --approve --offline --no-session --mode json -p \"/jev status\"",
    "jev:auth": "node scripts/jev-auth.mjs",
    "jev:status": "tsx scripts/jev.ts status",
    "jev:models": "tsx scripts/jev.ts models",
    "jev:test": "tsx scripts/jev.ts test"
  },
  "engines": {"node": ">=22.19.0"},
  "dependencies": {"@typesafe-ai/sdk": "0.6.0"},
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.87.1",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@types/node": "^22.19.0",
    "tsx": "^4.20.0",
    "typebox": "1.3.27",
    "typescript": "5.9.3"
  }
}
