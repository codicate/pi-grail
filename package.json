{
  "name": "pi-grail",
  "version": "0.1.0",
  "private": true,
  "description": "Pi extension with TypeSafe Jev and interchangeable Jev/subagent Grail selectors",
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/codicate/pi-grail.git"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "jev"
  ],
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "scripts": {
    "dev": "node scripts/pi.mjs --approve",
    "link": "node scripts/pi.mjs install .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "test:pi": "tsx scripts/test-pi.ts",
    "test:pi:live": "tsx scripts/test-pi-live.ts",
    "pi:status": "node scripts/pi.mjs --approve --offline --no-session --mode json -p \"/jev status\"",
    "pi:auth": "node scripts/pi-auth.mjs",
    "test:reasoning:live": "tsx scripts/test-reasoning-live.ts",
    "grail:status": "node scripts/pi.mjs --approve --offline --no-session --mode json -p \"/grail status\"",
    "test:grail:live": "tsx scripts/test-grail-live.ts",
    "test:grail": "tsx scripts/test-grail-pi.ts",
    "test:grail:child": "tsx scripts/test-grail-child.ts",
    "test:grail:jev": "tsx scripts/test-grail-jev.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "benchmark:labels": "tsx scripts/benchmark-labels.ts",
    "jev:auth": "node scripts/jev-auth.mjs",
    "jev:status": "tsx scripts/jev.ts status",
    "jev:models": "tsx scripts/jev.ts models",
    "jev:test": "tsx scripts/jev.ts test"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "0.6.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.87.1",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@types/node": "^22.19.0",
    "pi-subagents": "0.71.0",
    "tsx": "^4.20.0",
    "typebox": "1.3.27",
    "typescript": "5.9.3"
  }
}
